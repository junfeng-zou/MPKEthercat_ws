<?xml version="1.0"?>
<robot name="single_motor_testbench">

  <link name="base_link"/>

  <link name="motor_link"/>

  <joint name="motor_joint_1" type="continuous">
    <parent link="base_link"/>
    <child link="motor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> </joint>

  <ros2_control name="EthercatHardware" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">1000</param>
    </hardware>

    <joint name="motor_joint_1">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="status_word"/>
      <state_interface name="op_mode"/>
      <command_interface name="control_word"/>
      <command_interface name="op_mode"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>

      
      <ec_module name="my_motor">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="slave_config">/home/lsjzf/MPK_SDK/MPKEthercat_ws/src/mpk_ethercat_test/config/motor_config.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>

</robot>