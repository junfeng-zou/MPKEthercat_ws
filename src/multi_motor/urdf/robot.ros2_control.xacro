<?xml version="1.0"?>
<!--
  robot.ros2_control.xacro
  ============================================================
  ros2_control description for a Denali-XCR multi-motor EtherCAT
  system. Backend: ICube-Robotics/ethercat_driver_ros2
  Plugin:         ethercat_generic_plugins/EcCiA402Drive

  Usage (from a top-level URDF):
    <xacro:include filename="$(find multi_motor_control)/urdf/robot.ros2_control.xacro"/>
    <xacro:multi_motor_ros2_control
        name="denali_cluster"
        num_joints="3"
        slave_config="$(find multi_motor_control)/config/ethercat_system.yaml"/>
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Macro that generates one <joint> block
       ============================================================
       One Denali XCR drive = one EtherCAT slave = one <joint>.
       `index` is 1-based and maps 1:1 onto EtherCAT `position`
       (ring position on the bus), starting from 0.
  -->
  <!--
    denali_xcr_joint : one joint = one EtherCAT slave

    Parameters:
      index          : joint number (1-based), used for the joint name
      slave_position : PHYSICAL bus position of this slave (0-based).
                       This is the EtherCAT ring slot, NOT the joint index.
                       When joints on the bus are not contiguous
                       (e.g. joint1+joint3+joint4 wired as slots 0,1,2)
                       you MUST pass the correct slot here.
                       Default = index-1  (correct only when ALL joints
                       from 1..N are present and wired in order).
      slave_config   : path to ethercat_system.yaml
      master_id      : IgH master index (default 0)
  -->
  <xacro:macro name="denali_xcr_joint"
               params="index slave_config master_id:=0 slave_position:=${index - 1}">
    <joint name="joint_${index}">

      <!-- State interfaces (exposed by EcCiA402Drive via TxPDO) -->
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="status_word"/>
      <state_interface name="modes_of_operation_display"/>

      <!-- Command interfaces
           NOTE: declaring `control_word` disables the plugin's
           auto-enable behaviour the moment a non-NaN value is
           written. The YAML sets `default: 0` so the drive stays
           DISABLED between power-on and the first GUI command.
      -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="control_word"/>
      <command_interface name="modes_of_operation"/>
      <command_interface name="reset_fault"/>

      <ec_module name="denali_xcr_${index}">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <!--
          slave_position = physical EtherCAT bus slot (0-based).
          Do NOT change this to `index-1` blindly: if you skip joints
          (e.g. only joint1+joint3+joint4 on the bus) each drive must
          declare the slot it actually occupies.
        -->
        <param name="position">${slave_position}</param>
        <!-- Do NOT set `mode_of_operation` here - GUI will set it
             through the modes_of_operation command_interface. -->
        <param name="slave_config">${slave_config}</param>
      </ec_module>
    </joint>
  </xacro:macro>

  <!-- ============================================================
       Macro that generates the full <ros2_control> block
       ============================================================
       Tip for 3->8 expansion: only change `num_joints`.
       The `${xacro.python_expression(...)}` trick is used to
       loop because xacro has no real foreach; we expand explicitly
       in the macro below via tail-recursion.
  -->
  <!--
    _joint_list: recursive helper used when num_joints are wired
    SEQUENTIALLY starting from slot 0 (the common case).
    slave_position defaults to i-1 so slot assignment is automatic.
    For non-contiguous wiring, instantiate denali_xcr_joint directly
    from a custom xacro instead of using this helper.
  -->
  <xacro:macro name="_joint_list" params="i num slave_config">
    <xacro:if value="${i &lt;= num}">
      <!-- slave_position = i-1 : joint_i occupies bus slot i-1 -->
      <xacro:denali_xcr_joint index="${i}" slave_config="${slave_config}"
                              slave_position="${i - 1}"/>
      <xacro:_joint_list i="${i+1}" num="${num}" slave_config="${slave_config}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="multi_motor_ros2_control"
               params="name num_joints slave_config master_id:=0 control_frequency:=1000">

    <ros2_control name="${name}" type="system">

      <hardware>
        <plugin>ethercat_driver/EthercatDriver</plugin>
        <param name="master_id">${master_id}</param>
        <param name="control_frequency">${control_frequency}</param>
      </hardware>

      <!-- Expand joint_1 ... joint_N -->
      <xacro:_joint_list i="1" num="${num_joints}" slave_config="${slave_config}"/>

    </ros2_control>

  </xacro:macro>

</robot>
